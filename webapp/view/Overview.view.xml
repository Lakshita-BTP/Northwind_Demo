<mvc:View controllerName="northwinddemo.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page title="Employees">
        <content>
            <Panel headerText="New Customer" expandable="true" expanded="true">
                <content>
                    <f:SimpleForm layout="ColumnLayout" editable="true">
                        <f:toolbar>
                            <Toolbar>
                                <content>
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://create" text="Create Customer"/>
                                </content>
                            </Toolbar>
                        </f:toolbar>
                        <f:content>
                            <core:Title text="General Data 1"/>
                                <Label text="LastName"/><Input value="{input>/LastName}"/>
                                <Label text="FirstName"/><Input value="{input>/FirstName}"/>
                                <Label text="Title"/><Input value="{input>/Title}"/>
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Panel>
        </content>
        <Table headerText="Total Employees" growing="true" growingThreshold="10" class="sapUiResponsiveMargin" width="auto" items="{ path: '/Employees'}">
            <columns>
                <Column><header><Text text="EmployeeID"/></header></Column>
                <Column><header><Text text="LastName"/></header></Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <ObjectIdentifier title="{EmployeeID}"/>
                        <Text text="{LastName}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>