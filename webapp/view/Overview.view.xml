<mvc:View controllerName="northwinddemo.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page title="Employees">
        <content>
            <Panel headerText="New Customer" expandable="true" expanded="true">
                <content>
                    <f:SimpleForm layout="ColumnLayout" editable="true">
                        <f:toolbar>
                            <Toolbar>
                                <content>
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://create" text="Create Customer"/>
                                </content>
                            </Toolbar>
                        </f:toolbar>
                        <f:content>
                            <core:Title text="General Data 1"/>
                                <Label text="LastName"/><Input value="{input>/LastName}"/>
                                <Label text="FirstName"/><Input value="{input>/FirstName}"/>
                                <Label text="Title"/><Input value="{input>/Title}"/>
                            <core:Title text="General Data 2"/>
                                <Label text="TitleOfCourtesy"/><Input value="{input>/TitleOfCourtesy}"/>
                                <Label text="BirthDate"/><Input value="{input>/BirthDate}"/>
                                <Label text="HireDate"/><Input value="{input>/HireDate}"/>
                                <Label text="Address"/><Input value="{input>/Address}"/>
                            <core:Title text="General Data 3"/>
                                <Label text="City"/><Input value="{input>/City}"/>
                                <Label text="Region"/><Input value="{input>/Region}"/>
                                <Label text="PostalCode"/><Input value="{input>/PostalCode}"/>
                            <core:Title text="General Data 4"/>
                                <Label text="Country"/><Input value="{input>/Country}"/>
                                <Label text="HomePhone"/><Input value="{input>/HomePhone}"/>
                                <Label text="Extension"/><Input value="{input>/Extension}"/>
                                <Label text="Photo"/><Input value="{input>/Photo}"/>
                        </f:content>
                    </f:SimpleForm>
                </content>
            </Panel>
        </content>
        <Table headerText="Total Employees" growing="true" growingThreshold="10" class="sapUiResponsiveMargin" width="auto" items="{ path: '/Employees'}">
            <columns>
                <Column><header><Text text="EmployeeID"/></header></Column>
                <Column><header><Text text="LastName"/></header></Column>
                <Column><header><Text text="FirstName"/></header></Column>
                <Column><header><Text text="Title"/></header></Column>
                <Column><header><Text text="TitleOfCourtesy"/></header></Column>
                <Column><header><Text text="BirthDate"/></header></Column>
                <Column><header><Text text="HireDate"/></header></Column>
                <Column><header><Text text="Address"/></header></Column>
                <Column><header><Text text="City"/></header></Column>
                <Column><header><Text text="Region"/></header></Column>
                <Column><header><Text text="PostalCode"/></header></Column>
                <Column><header><Text text="Country"/></header></Column>
                <Column><header><Text text="HomePhone"/></header></Column>
                <Column><header><Text text="Extension"/></header></Column>
                <Column><header><Text text="Notes"/></header></Column>
                <Column><header><Text text="ReportsTo"/></header></Column>
                <Column><header><Text text="PhotoPath"/></header></Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <ObjectIdentifier title=""/>
                        <Text text="{EmployeeID}"/>
                        <Text text="{LastName}"/>
                        <Text text="{FirstName}"/>
                        <Text text="{Title}"/>
                        <Text text="{TitleOfCourtesy}"/>
                        <Text text="{BirthDate}"/>
                        <Text text="{HireDate}"/>
                        <Text text="{Address}"/>
                        <Text text="{City}"/>
                        <Text text="{Region}"/>
                        <Text text="{PostalCode}"/>
                        <Text text="{Country}"/>
                        <Text text="{HomePhone}"/>
                        <Text text="{Extension}"/>
                        <Text text="{Notes}"/>
                        <Text text="{ReportsTo}"/>
                        <Text text="{PhotoPath}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </Page>
</mvc:View>